# PLATIA Gateway: plantilla de configuración.
# Crea tu .env con: python scripts/generate_env.py  (sustituye cada <GENERAR> por un secreto aleatorio)

# development | production (en producción no se publica la documentación OpenAPI)
GATEWAY_ENV=development
# Puerto publicado por Nginx (PLATIA usa el 8080)
HTTP_PORT=8090

# --- MySQL (base de datos propia del gateway)
MYSQL_ROOT_PASSWORD=<GENERAR>
DB_USER=gateway
DB_PASSWORD=<GENERAR>
DB_NAME=platia_gateway
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Cifrado en reposo de las claves de proveedor (AES-256-GCM). Si se pierde, hay que
# volver a introducir las claves de proveedor; no se puede cambiar sin recifrarlas.
ENCRYPTION_KEY=<GENERAR_FERNET>

# --- Llamadas a los proveedores (segundos) y tamaño máximo de una petición (bytes).
# Nginx corta tras 330 s sin datos: PROVIDER_TIMEOUT_SECONDS debe ser menor. En streaming
# es el tiempo máximo entre dos fragmentos.
PROVIDER_CONNECT_TIMEOUT_SECONDS=10
PROVIDER_TIMEOUT_SECONDS=300
# Duración máxima de una respuesta en streaming
STREAM_MAX_SECONDS=1800
MAX_BODY_BYTES=10485760

# --- Reserva y enfriamiento de despliegues (G6). Si un destino falla, se prueba el
# siguiente de la cadena (como mucho ROUTE_MAX_ATTEMPTS, y solo durante los primeros
# ROUTE_RETRY_WINDOW_SECONDS). Un despliegue con COOLDOWN_FAILURES fallos en
# COOLDOWN_WINDOW_SECONDS, o con un 429, pasa al final de la cola durante COOLDOWN_SECONDS
# (con un 429, lo que pida el proveedor, hasta COOLDOWN_MAX_SECONDS).
ROUTE_MAX_ATTEMPTS=3
ROUTE_RETRY_WINDOW_SECONDS=120
COOLDOWN_FAILURES=3
COOLDOWN_WINDOW_SECONDS=60
COOLDOWN_SECONDS=60
COOLDOWN_MAX_SECONDS=300

# --- Auditoría encadenada (G9). El gateway sella las filas cerradas cada
# AUDIT_SEAL_INTERVAL_SECONDS (0 = no sella solo; queda la orden audit-seal). Una fila
# pendiente más de AUDIT_PENDING_MAX_SECONDS se cierra como error (el cierre se perdió).
AUDIT_SEAL_INTERVAL_SECONDS=10
AUDIT_PENDING_MAX_SECONDS=2400

# --- Identidad de personas (G10): panel y portal. JWT_SECRET firma los tokens de acceso
# (si cambia, todos tienen que volver a entrar). Un acceso dura ACCESS_TOKEN_MINUTES; la
# sesión caduca sin uso en SESSION_IDLE_DAYS y siempre en SESSION_MAX_DAYS. Con
# REQUIRE_MFA_FOR_ADMINS, un administrador sin MFA solo puede configurarlo. Tras
# LOGIN_MAX_FAILURES contraseñas fallidas, LOGIN_LOCKOUT_SECONDS de espera. La cookie de la
# sesión solo viaja por HTTPS con AUTH_COOKIE_SECURE=true ("auto": sí en producción).
JWT_SECRET=<GENERAR>
ACCESS_TOKEN_MINUTES=15
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
REQUIRE_MFA_FOR_ADMINS=true
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900
AUTH_COOKIE_SECURE=auto

# --- Redis
REDIS_PASSWORD=<GENERAR>
REDIS_DB=0

# --- Salud y logs
HEALTH_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
LOG_FORMAT=json
